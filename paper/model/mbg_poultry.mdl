Broiler harvest=
	Broilers in growout / Growout time * (1 - Growout mortality)
	~	bird/Week
	~	
	|

Growout mortality loss=
	Broilers in growout / Growout time * Growout mortality
	~	bird/Week
	~	
	|

Chicken production=
	Broiler harvest * Meat per bird / 1000
	~	t/Week
	~	
	|

Chicken spoilage fraction=
	0.02
	~	1/Week
	~	
	|

Normal chicken coverage=
	1
	~	Week
	~	
	|

Reference household chicken demand=
	Initial chicken production / (1 + Chicken spoilage fraction * Normal chicken coverage)
	~	t/Week
	~	
	|

Chicken inventory=
	INTEG(Chicken production - Chicken sales - Chicken spoilage, Reference household chicken demand * Normal chicken coverage)
	~	t
	~	STOCK
	|

Chicken spoilage=
	Chicken inventory * Chicken spoilage fraction
	~	t/Week
	~	
	|

Chicken available=
	Chicken inventory / Minimum delivery time
	~	t/Week
	~	
