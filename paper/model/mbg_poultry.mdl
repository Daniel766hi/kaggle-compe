{UTF-8}
INITIAL TIME=
	0
	~	Week
	~	Week 0 = first week of Jan 2024.
	|

FINAL TIME=
	312
	~	Week
	~	Six years: 2024-2029.
	|

TIME STEP=
	0.03125
	~	Week [0,?]
	~	Halved in integration tests B1/B2. The shortest time constant is the 0.5-week minimum delivery time, which binds when demand jumps as schools reopen; 0.0625 failed B1 (1.5 percent of range, chicken price after school holidays), so the step was halved to 0.03125 (1/16 of that time constant).
	|

SAVEPER=
	1
	~	Week [0,?]
	~	
	|

Programme start time=
	53
	~	Week
	~	MBG launched 6 January 2025 (week 53 from 1 Jan 2024).
	|

Target kitchens=
	29834
	~	kitchen
	~	From data: fitted so that modelled operational SPPG match BGN counts (fit_rollout.py, data/rollout_fit.csv).
	|

Rollout midpoint=
	92.02
	~	Week
	~	From data: fitted to BGN SPPG counts via operational kitchens (fit_rollout.py).
	|

Rollout steepness=
	7.35
	~	Week
	~	From data: fitted to BGN SPPG counts via operational kitchens (fit_rollout.py). POLICY P1 (phased roll-out) increases it.
	|

Rollout fraction=
	IF THEN ELSE(Time >= Programme start time, 1 / (1 + EXP(-(Time - Rollout midpoint) / Rollout steepness)), 0)
	~	Dmnl
	~	Logistic (S-shaped) roll-out fitted to observed SPPG counts.
	|

Planned kitchens=
	Target kitchens * Rollout fraction
	~	kitchen
	~	
	|

Operational kitchens=
	INTEG(Kitchen opening rate + Reinstatement rate - Suspension rate, 0)
	~	kitchen
	~	STOCK
	|

Suspended kitchens=
	INTEG(Suspension rate - Reinstatement rate, 0)
	~	kitchen
	~	STOCK
	|

Kitchen opening delay=
	4
	~	Week
	~	ASSUMPTION (no public data): weeks from planning to operation. Explored 2-8 in the ensemble. UNCERTAINTY.
	|

Kitchen opening rate=
	MAX(0, Planned kitchens - Operational kitchens - Suspended kitchens) / Kitchen opening delay
	~	kitchen/Week
	~	
	|

Reinstatement time=
	15.10
	~	Week
	~	From data: fitted with Base suspension fraction (fit_suspensions.py).
	|

Reinstatement rate=
	Suspended kitchens / Reinstatement time
	~	kitchen/Week
	~	
	|

Base suspension fraction=
	0.00419
	~	1/Week
	~	From data: fitted to BGN reports of 8,182 SPPG ever suspended and 2,213 inactive by end May 2026 (fit_suspensions.py). UNCERTAINTY.
	|

Sustainable opening capacity=
	300
	~	kitchen/Week
	~	ASSUMPTION (no public data): openings per week the system can supervise without quality loss. Observed openings peaked at approx. 700 per week in late 2025. Explored 150-700 in the ensemble. UNCERTAINTY.
	|

Scaling strain=
	Kitchen opening rate / Sustainable opening capacity
	~	Dmnl
	~	
	|

Strain sensitivity=
	2
	~	Dmnl
	~	UNCERTAINTY: strength of the scaling-strain effect on suspensions.
	|

Effect of scaling strain on suspension=
	1 + Strain sensitivity * MAX(0, Scaling strain - 1)
	~	Dmnl
	~	
	|

Suspension rate=
	Operational kitchens * Base suspension fraction * Effect of scaling strain on suspension
	~	kitchen/Week
	~	Scaling strain -> suspensions. Not a feedback loop: suspended kitchens are subtracted from the opening gap, so suspensions are replaced by new openings.
	|

Beneficiaries per kitchen=
	IF THEN ELSE(Time <= Last observed beneficiary week, Observed beneficiaries per kitchen(Time), Observed beneficiaries per kitchen(Last observed beneficiary week) + (Future beneficiaries per kitchen - Observed beneficiaries per kitchen(Last observed beneficiary week)) * MIN(1, (Time - Last observed beneficiary week) / Beneficiary adjustment time))
	~	person/kitchen
	~	Reported beneficiaries / operational SPPG (BGN, Kemenkeu). Approx. 2,700-3,200 to Feb 2026, approx. 2,000 in Sep 2026 (53-57 million / 27,485). After the last observation it moves to an uncertain future level.
	|

Observed beneficiaries per kitchen(
	[(0,0)-(320,4000)],(54.57,2731),(84.29,2865),(88.00,2942),(90.86,3224),(104.29,2872),(107.00,2763),(110.43,2968),(143.29,2001))
	~	person/kitchen
	~	Reported beneficiaries / operational SPPG: 17 Jan 2025 (238 SPPG, 0.65 m), 13 Aug 2025 (5,235, 15 m), 8 Sep 2025 (7,477, 22 m), 28 Sep 2025 (9,615, 31 m), 31 Dec 2025 (19,188, 55.1 m), 19 Jan 2026 (21,102, 58.3 m), 12 Feb 2026 (21,897, 65 m), 30 Sep 2026 (27,485, 53-57 m; midpoint used).
	|

Last observed beneficiary week=
	143.29
	~	Week
	~	30 Sep 2026.
	|

Future beneficiaries per kitchen=
	2000
	~	person/kitchen
	~	UNCERTAINTY (1,900-2,900): from the Sep 2026 level up to the earlier level; BGN cap 2,500 portions per SPPG (3,000 with certified cooks), Keputusan Kepala BGN 244/2025.
	|

Beneficiary adjustment time=
	26
	~	Week
	~	Time to move from the last observed ratio to the future level.
	|

Beneficiaries served=
	Operational kitchens * Beneficiaries per kitchen
	~	person
	~	
	|

School holiday indicator(
	[(0,0)-(320,1)],(0,0),(63.999,0),(64,1),(65.999,1),(66,0),(76.999,0),(77,1),(79.874,1),(79.875,0),(102.6865,0),(102.6875,1),(104.749,1),(104.75,0),(114.5615,0),(114.5625,1),(116.5615,1),(116.5625,0),(129.124,0),(129.125,1),(131.999,1),(132,0),(154.874,0),(154.875,1),(156.874,1),(156.875,0),(165.3115,0),(165.3125,1),(167.3115,1),(167.3125,0),(181.3115,0),(181.3125,1),(184.124,1),(184.125,0),(206.999,0),(207,1),(208.999,1),(209,0),(215.874,0),(215.875,1),(217.874,1),(217.875,0),(233.5615,0),(233.5625,1),(236.4365,1),(236.4375,0),(259.3115,0),(259.3125,1),(261.3115,1),(261.3125,0),(266.3115,0),(266.3125,1),(268.3115,1),(268.3125,0),(285.6865,0),(285.6875,1),(288.5615,1),(288.5625,0),(311.4365,0),(311.4375,1),(313.4365,1),(313.4375,0),(320,0))
	~	Dmnl
	~	1 during school holidays: approx. 23 Jun-13 Jul and 20 Dec-3 Jan each year, and one week either side of Idul Fitri (approximate national calendar; verify against provincial calendars). Start and end dates are rounded to the nearest 1/16 week (about 10 hours) so that every integration grid used in tests B1/B2 samples the same on/off times.
	|

Holiday service share=
	IF THEN ELSE(Time >= Holiday rule change time, 0, Holiday service share before rule change)
	~	Dmnl
	~	Share of programme demand still served during school holidays.
	|

Holiday service share before rule change=
	0.2
	~	Dmnl
	~	Pregnant and breastfeeding mothers and toddlers kept receiving meals in holidays (about 500 of 2,500 portions per SPPG, Keputusan Kepala BGN 244/2025); school deliveries in holidays were optional.
	|

Holiday rule change time=
	128.625
	~	Week
	~	BGN circular SE 12/2026 (June 2026): distribution to all groups stops on school holidays, public holidays and weekends.
	|

Programme in session=
	1 - School holiday indicator(Time) * (1 - Holiday service share)
	~	Dmnl
	~	Fraction of normal programme demand in a given week.
	|

Programme coverage=
	ZIDZ(Beneficiaries served, Target kitchens * Beneficiaries per kitchen)
	~	Dmnl
	~	OUTCOME
	|

Portions per beneficiary=
	5
	~	portion/(person*Week)
	~	Meals are served on school days only (five per week) following the 2026 schedule change; previously six. Affects cost per portion only.
	|

Egg per beneficiary=
	Egg serving size * IF THEN ELSE(Time >= Egg menu change time, Egg servings after menu change, Egg servings before menu change)
	~	kg/(person*Week)
	~	Eggs about twice a week (BGN head, Apr 2025: 480 kt/yr for 82.9 million assumes two egg dishes a week); at least three a week agreed by BGN and farmer groups on 8 June 2026.
	|

Egg serving size=
	0.06
	~	kg/serving
	~	One egg, approx. 60 g. UNCERTAINTY 0.05-0.065.
	|

Egg servings before menu change=
	2
	~	serving/(person*Week)
	~	BGN planning assumption (two egg dishes a week).
	|

Egg servings after menu change=
	3
	~	serving/(person*Week)
	~	At least three a week from 8 June 2026 (described as temporary). UNCERTAINTY 2-4.
	|

Egg menu change time=
	127.0
	~	Week
	~	8 June 2026.
	|

Chicken per beneficiary=
	0.18
	~	kg/(person*Week)
	~	No published menu specification. Official estimates conflict: Agriculture Minister 1.1 Mt/yr for the full programme (approx. 0.255 kg); Bapanas SPPG need 222.7 kt in 2025; another report 70 kt/yr. Treated as deep UNCERTAINTY 0.08-0.26.
	|

Menu flexibility switch=
	0
	~	Dmnl
	~	POLICY P4 (0/1): substitute protein when price is high.
	|

Max menu substitution=
	0.5
	~	Dmnl
	~	Max share of egg/chicken replaced (fish, tempeh, tofu).
	|

Substitution price threshold=
	1.15
	~	Dmnl
	~	Relative price above which substitution starts.
	|

Egg menu multiplier=
	1 - Menu flexibility switch * Max menu substitution * MIN(1, MAX(0, (Relative egg price - Substitution price threshold) / 0.2))
	~	Dmnl
	~	
	|

Chicken menu multiplier=
	1 - Menu flexibility switch * Max menu substitution * MIN(1, MAX(0, (Relative chicken price - Substitution price threshold) / 0.2))
	~	Dmnl
	~	
	|

MBG egg demand=
	Beneficiaries served * Egg per beneficiary * Egg menu multiplier * Programme in session / 1000
	~	t/Week
	~	
	|

MBG chicken demand=
	Beneficiaries served * Chicken per beneficiary * Chicken menu multiplier * Programme in session / 1000
	~	t/Week
	~	
	|

Forward contract share=
	0
	~	Dmnl
	~	POLICY P3 (0-1): share of future programme demand contracted in advance with farmers.
	|

Contract lead time=
	20
	~	Week
	~	How far ahead contracted demand is announced.
	|

Anticipated rollout fraction=
	IF THEN ELSE(Time + Contract lead time >= Programme start time, 1 / (1 + EXP(-(Time + Contract lead time - Rollout midpoint) / Rollout steepness)), 0)
	~	Dmnl
	~	
	|

Anticipated MBG egg demand=
	Target kitchens * Anticipated rollout fraction * Beneficiaries per kitchen * Egg per beneficiary / 1000
	~	t/Week
	~	
	|

Anticipated MBG chicken demand=
	Target kitchens * Anticipated rollout fraction * Beneficiaries per kitchen * Chicken per beneficiary / 1000
	~	t/Week
	~	
	|

Cooperative sourcing share=
	0.1
	~	Dmnl
	~	POLICY P2 (0-1): share bought directly from farmer groups/cooperatives.
	|

Intermediary margin=
	0.2
	~	Dmnl
	~	Mark-up paid by SPPG buying via traders relative to market price. Evidence: BPS trade and transport margin (MPP) for eggs 26.8% (2017), 13.1% (2018), 20.2% (2021). Range 0.10-0.30.
	|

Egg procurement price=
	Egg price * (1 + Intermediary margin * (1 - Cooperative sourcing share))
	~	Rp/kg
	~	
	|

Chicken procurement price=
	Chicken price * (1 + Intermediary margin * (1 - Cooperative sourcing share))
	~	Rp/kg
	~	
	|

Programme protein cost=
	(MBG egg sales * Egg procurement price + MBG chicken sales * Chicken procurement price) * 1000
	~	Rp/Week
	~	
	|

Protein cost per portion=
	Programme protein cost / MAX(1, Beneficiaries served * Portions per beneficiary)
	~	Rp/portion
	~	OUTCOME
	|

Feed shock magnitude=
	0
	~	Dmnl
	~	UNCERTAINTY: relative rise in world feed price during the shock.
	|

Feed shock time=
	120
	~	Week
	~	
	|

Feed shock duration=
	26
	~	Week
	~	
	|

Exogenous feed price index=
	1 + Feed shock magnitude * PULSE(Feed shock time, Feed shock duration)
	~	Dmnl
	~	
	|

Broiler feed weight=
	0.5
	~	Dmnl
	~	Feed use of a broiler relative to a layer.
	|

Total birds=
	Laying hens + Pullets + Broilers in growout * Broiler feed weight
	~	bird
	~	
	|

Initial total birds=
	INITIAL(Total birds)
	~	bird
	~	
	|

Feed price sensitivity to flock=
	0.3
	~	Dmnl
	~	Loop B3 strength.
	|

Relative feed price=
	Exogenous feed price index * (Total birds / Initial total birds) ^ Feed price sensitivity to flock
	~	Dmnl
	~	
	|

Egg mass=
	0.06
	~	kg/egg
	~	Standard chicken egg approx. 55-62 g (food exchange list: 55 g; commercial approx. 60 g).
	|

Lay rate=
	5.9
	~	egg/(bird*Week)
	~	Average hen-day production approx. 84.5% (Lohmann Brown, Indonesian field study) = 5.9 eggs per hen per week. Scales flock size only.
	|

Production per hen=
	Lay rate * Egg mass / 1000
	~	t/(bird*Week)
	~	
	|

Initial egg production=
	121640
	~	t/Week
	~	BPS 2024 (preliminary): 6,342,705 t laying-hen eggs per year / 52.14 weeks.
	|

Initial laying hens=
	Initial egg production / Production per hen
	~	bird
	~	
	|

Productive life=
	65
	~	Week
	~	Laying from approx. week 19 to culling at approx. 80-90 weeks of age (Indonesian layer practice; some flocks to 100+). Range 60-85.
	|

Rearing time=
	18
	~	Week
	~	Pullets reach point of lay at approx. 16-21 weeks (Indonesian layer studies; Lohmann/Hy-Line guides). Range 16-21.
	|

Laying hens=
	INTEG(Maturation - Culling - Disease loss, Initial laying hens)
	~	bird
	~	STOCK
	|

Pullets=
	INTEG(Pullet placement - Maturation, Initial laying hens / Productive life * Rearing time)
	~	bird
	~	STOCK (supply line)
	|

Maturation=
	DELAY3(Pullet placement, Rearing time)
	~	bird/Week
	~	Third-order biological delay.
	|

Culling=
	Laying hens / Productive life
	~	bird/Week
	~	
	|

Outbreak loss fraction=
	0
	~	Dmnl
	~	Scenario input. Avian influenza is endemic in Indonesia; large flock losses are uncommon. Range 0-0.3 explored as stress test.
	|

Outbreak time=
	150
	~	Week
	~	
	|

Outbreak duration=
	4
	~	Week
	~	
	|

Disease loss=
	Laying hens * (-LN(1 - MIN(Outbreak loss fraction, 0.999))) * PULSE(Outbreak time, Outbreak duration) / Outbreak duration
	~	bird/Week
	~	Exponential loss so that exactly the stated fraction of hens is lost over the outbreak.
	|

Egg production=
	Laying hens * Production per hen
	~	t/Week
	~	
	|

Egg spoilage fraction=
	0.01
	~	1/Week
	~	
	|

Normal egg coverage=
	2
	~	Week
	~	Normal inventory in the distribution chain, in weeks of demand.
	|

Reference household egg demand=
	Initial egg production / (1 + Egg spoilage fraction * Normal egg coverage)
	~	t/Week
	~	Equilibrium household demand at baseline price.
	|

Egg inventory=
	INTEG(Egg production - Egg sales - Egg spoilage, Reference household egg demand * Normal egg coverage)
	~	t
	~	STOCK
	|

Egg spoilage=
	Egg inventory * Egg spoilage fraction
	~	t/Week
	~	
	|

Minimum delivery time=
	0.5
	~	Week
	~	
	|

Egg available=
	Egg inventory / Minimum delivery time
	~	t/Week
	~	
	|

Household egg elasticity=
	-0.669
	~	Dmnl
	~	Own-price elasticity of eggs, QUAIDS on SUSENAS 2021 (Khoiriyah et al. 2024). Ensemble range -1.0 to -0.5 (Bengkulu 2021: -0.82).
	|

Household egg demand=
	Reference household egg demand * Relative egg price ^ Household egg elasticity
	~	t/Week
	~	
	|

MBG egg sales=
	MIN(MBG egg demand, Egg available)
	~	t/Week
	~	Programme has delivery priority.
	|

Household egg sales=
	MIN(Household egg demand, Egg available - MBG egg sales)
	~	t/Week
	~	
	|

Egg sales=
	MBG egg sales + Household egg sales
	~	t/Week
	~	
	|

Total egg demand=
	MBG egg demand + Household egg demand
	~	t/Week
	~	
	|

Relative egg coverage=
	(Egg inventory / MAX(1, Total egg demand)) / Normal egg coverage
	~	Dmnl
	~	
	|

Baseline egg price=
	28140
	~	Rp/kg
	~	From data: 2024 mean of monthly national median retail price, WFP/HDX Indonesia Food Prices (see data/raw/SOURCE.txt).
	|

Normal egg margin=
	0.1
	~	Dmnl
	~	
	|

Egg feed cost share=
	0.7
	~	Dmnl
	~	Feed approx. 60-70% of poultry production cost (Kementan); 70% often cited for layers. Range 0.6-0.8.
	|

Base egg unit cost=
	Baseline egg price / (1 + Normal egg margin)
	~	Rp/kg
	~	
	|

Egg unit cost=
	Base egg unit cost * (Egg feed cost share * Relative feed price + 1 - Egg feed cost share)
	~	Rp/kg
	~	
	|

Price sensitivity to coverage=
	1
	~	Dmnl
	~	Not identified by the price data (fit error nearly flat between 1 and 10; s02 identifiability profile). Fixed at 1 and explored 0.5-3 in the ensemble. UNCERTAINTY.
	|

Cost pull weight=
	0.3
	~	Dmnl
	~	How strongly price is pulled toward cost plus normal margin.
	|

Maximum relative price=
	3
	~	Dmnl
	~	UNCERTAINTY: price ceiling relative to baseline set by imports, substitutes and government market operations.
	|

Price adjustment time=
	2
	~	Week
	~	
	|

Indicated egg price=
	MIN(Maximum relative price * Baseline egg price, Egg price * Relative egg coverage ^ (-Price sensitivity to coverage) * (Egg unit cost * (1 + Normal egg margin) / Egg price) ^ Cost pull weight)
	~	Rp/kg
	~	
	|

Change in egg price=
	(Indicated egg price - Egg price) / Price adjustment time
	~	Rp/(kg*Week)
	~	
	|

Egg price=
	INTEG(Change in egg price, Baseline egg price)
	~	Rp/kg
	~	STOCK
	|

Relative egg price=
	Egg price / Baseline egg price
	~	Dmnl
	~	OUTCOME
	|

Price expectation delay=
	8
	~	Week
	~	UNCERTAINTY: farmer expectation-formation delay. Not identified by the price data (calibration moved it between 2 and 30 weeks); fixed at 8 weeks and explored over 4-16 in the ensemble. Find a literature value.
	|

Expected egg price=
	SMOOTH(Egg price, Price expectation delay)
	~	Rp/kg
	~	
	|

Expected egg margin=
	(Expected egg price - Egg unit cost) / Egg unit cost
	~	Dmnl
	~	
	|

Egg farmer margin=
	(Egg price - Egg unit cost) / Egg unit cost
	~	Dmnl
	~	OUTCOME
	|

Investment sensitivity=
	1.5
	~	Dmnl
	~	UNCERTAINTY: response of desired flock to expected margin (loop B1).
	|

Effect of margin on desired hens=
	MAX(0.5, 1 + Investment sensitivity * (Expected egg margin - Normal egg margin))
	~	Dmnl
	~	
	|

Desired laying hens=
	Laying hens * Effect of margin on desired hens + Forward contract share * MAX(0, Anticipated MBG egg demand - MBG egg demand) / Production per hen
	~	bird
	~	
	|

Expected hen loss=
	SMOOTH(Culling + Disease loss, 4)
	~	bird/Week
	~	
	|

Desired pullets=
	Expected hen loss * Rearing time
	~	bird
	~	
	|

Capacity adjustment time=
	26
	~	Week
	~	
	|

Supply line weight=
	0.5
	~	Dmnl
	~	UNCERTAINTY: 1 = farmers fully account for pullets in rearing; <1 causes overshoot.
	|

Hatchery capacity factor=
	1.5
	~	Dmnl
	~	UNCERTAINTY: max pullet placement relative to baseline replacement.
	|

Max pullet placement=
	Hatchery capacity factor * Initial laying hens / Productive life
	~	bird/Week
	~	
	|

Indicated pullet placement=
	Expected hen loss + (Desired laying hens - Laying hens) / Capacity adjustment time + Supply line weight * (Desired pullets - Pullets) / Capacity adjustment time
	~	bird/Week
	~	
	|

Pullet placement=
	MIN(Max pullet placement, MAX(0, Indicated pullet placement))
	~	bird/Week
	~	
	|

Household egg consumption ratio=
	Household egg sales / Reference household egg demand
	~	Dmnl
	~	OUTCOME
	|

Initial chicken production=
	73565
	~	t/Week
	~	BPS 2024 (preliminary): 3,835,917 t broiler meat per year / 52.14 weeks.
	|

Meat per bird=
	1.37
	~	kg/bird
	~	Harvest at 30-36 days, live weight approx. 1.7-2.2 kg (Indonesian farm reports), carcass approx. 70-75% of live weight: approx. 1.9 kg x 0.72. Scales bird numbers only.
	|

Growout time=
	5
	~	Week
