	|

Chicken unit cost=
	Base chicken unit cost * (Chicken feed cost share * Relative feed price + 1 - Chicken feed cost share)
	~	Rp/kg
	~	
	|

Indicated chicken price=
	MIN(Maximum relative price * Baseline chicken price, Chicken price * Relative chicken coverage ^ (-Price sensitivity to coverage) * (Chicken unit cost * (1 + Normal chicken margin) / Chicken price) ^ Cost pull weight)
	~	Rp/kg
	~	
	|

Change in chicken price=
	(Indicated chicken price - Chicken price) / Price adjustment time
	~	Rp/(kg*Week)
	~	
	|

Chicken price=
	INTEG(Change in chicken price, Baseline chicken price)
	~	Rp/kg
	~	STOCK
	|

Relative chicken price=
	Chicken price / Baseline chicken price
	~	Dmnl
	~	OUTCOME
	|

Expected chicken price=
	SMOOTH(Chicken price, Price expectation delay / 2)
	~	Rp/kg
	~	Broiler farmers react faster (short cycle).
	|

Expected chicken margin=
	(Expected chicken price - Chicken unit cost) / Chicken unit cost
	~	Dmnl
	~	
	|

Broiler investment sensitivity=
	1
	~	Dmnl
	~	UNCERTAINTY
	|

Effect of margin on broiler placement=
	MAX(0.5, 1 + Broiler investment sensitivity * (Expected chicken margin - Normal chicken margin))
	~	Dmnl
	~	
	|

Demand forecast time=
	4
	~	Week
	~	
	|

Expected chicken demand=
	SMOOTH(Total chicken demand, Demand forecast time)
	~	t/Week
	~	
	|

Inventory adjustment time=
	2
	~	Week
	~	
	|

Desired chicken production=
	(Expected chicken demand + Chicken spoilage) * Effect of margin on broiler placement + (Expected chicken demand * Normal chicken coverage - Chicken inventory) / Inventory adjustment time + Forward contract share * MAX(0, Anticipated MBG chicken demand - MBG chicken demand)
	~	t/Week
	~	
	|

DOC capacity factor=
	1.2
	~	Dmnl
	~	Day-old-chick supply chronically exceeds demand: Jan 2020 projected production 317 million vs demand 259.6 million (Kontan), ratio approx. 1.22; repeated government culling programmes. Range 1.05-1.4.
	|

Max DOC placement=
	DOC capacity factor * Initial DOC placement
	~	bird/Week
	~	
	|

DOC placement=
	MIN(Max DOC placement, MAX(0, Desired chicken production * 1000 / Meat per bird / (1 - Growout mortality)))
	~	bird/Week
	~	
	|

Household chicken consumption ratio=
	Household chicken sales / Reference household chicken demand
	~	Dmnl
	~	OUTCOME
	|

